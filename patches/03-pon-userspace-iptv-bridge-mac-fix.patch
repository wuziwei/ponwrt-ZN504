+++ b/luci-app-iptv/root/usr/libexec/iptv-apply
@@ -262,8 +262,22 @@ write_network_config() {
 		uci set network.luci_iptv_bridge.igmp_snooping='0'
 		uci add_list network.luci_iptv_bridge.ports="$LAN_PORT"
 		uci add_list network.luci_iptv_bridge.ports='ct-iptv-svc'
-		[ -n "$MULTICAST_VLAN" ] && uci add_list network.luci_iptv_bridge.ports='ct-iptv-mc'
-		[ "$IGMP_PORT" = 'ct-iptv-igmp' ] && uci add_list network.luci_iptv_bridge.ports='ct-iptv-igmp'
+		if [ -n "$MULTICAST_VLAN" ]; then
+			uci add_list network.luci_iptv_bridge.ports='ct-iptv-mc'
+			uci -q delete network.luci_iptv_mc_port
+			uci set network.luci_iptv_mc_port='bridge-port'
+			uci set network.luci_iptv_mc_port.device='ct-iptv-mc'
+			uci set network.luci_iptv_mc_port.learning='0'
+			uci set network.luci_iptv_mc_port.isolate='1'
+		fi
+		if [ "$IGMP_PORT" = 'ct-iptv-igmp' ]; then
+			uci add_list network.luci_iptv_bridge.ports='ct-iptv-igmp'
+			uci -q delete network.luci_iptv_igmp_port
+			uci set network.luci_iptv_igmp_port='bridge-port'
+			uci set network.luci_iptv_igmp_port.device='ct-iptv-igmp'
+			uci set network.luci_iptv_igmp_port.learning='0'
